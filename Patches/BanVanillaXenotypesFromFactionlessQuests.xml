<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- prevent non-fallout xenotype from being used for factionless pawns in quests -->

  <Operation Class="PatchOperationConditional" MayRequire="Ludeon.RimWorld.Biotech">
    <xpath>Defs/XenotypeDef[defName="Dirtmole"]/factionlessGenerationWeight</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/XenotypeDef[defName="Dirtmole"]/factionlessGenerationWeight</xpath>
      <value><factionlessGenerationWeight>0</factionlessGenerationWeight></value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/XenotypeDef[defName="Dirtmole"]</xpath>
      <value><factionlessGenerationWeight>0</factionlessGenerationWeight></value>
    </nomatch>
  </Operation>

