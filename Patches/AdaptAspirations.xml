<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Drink aperitif (VFE Empire) → drink nuka-cola (FCP) -->

  <Operation Class="PatchOperationReplace" MayRequire="VanillaExpanded.VanillaAspirationsExpanded,OskarPotocki.VFE.Empire,Rick.FCP.NukaCola">
    <xpath>Defs/VAspirE.AspirationDef[defName="VAspirE_DrinkAperitif"]/label</xpath>
    <value>
      <label>drink nuka-cola</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace" MayRequire="VanillaExpanded.VanillaAspirationsExpanded,OskarPotocki.VFE.Empire,Rick.FCP.NukaCola">
    <xpath>Defs/VAspirE.AspirationDef[defName="VAspirE_DrinkAperitif"]/description</xpath>
    <value>
      <description>{0} wants to crack open a nuka-cola.</description>
    </value>
  </Operation>

  <Operation Class="PatchOperationRemove" MayRequire="VanillaExpanded.VanillaAspirationsExpanded,OskarPotocki.VFE.Empire,Rick.FCP.NukaCola">
    <xpath>Defs/VAspirE.AspirationDef[defName="VAspirE_DrinkAperitif"]/satisfiedHediff</xpath>
  </Operation>

  <Operation Class="PatchOperationAdd" MayRequire="VanillaExpanded.VanillaAspirationsExpanded,OskarPotocki.VFE.Empire,Rick.FCP.NukaCola">
    <xpath>Defs/VAspirE.AspirationDef[defName="VAspirE_DrinkAperitif"]</xpath>
    <value>
      <satisfiedWhenText>{0} drinks any nuka-cola.</satisfiedWhenText>
      <satisfiedHediffAny>
        <li>FCP_Nuka_Cola_High</li>
        <li>FCP_Nuka_Cola_Cherry_High</li>
        <li>FCP_Nuka_Cola_Orange_High</li>
        <li>FCP_Nuka_Cola_Quantum_High</li>
        <li>FCP_Nuka_Cola_Quartz_High</li>
        <li>FCP_Nuka_Cola_Victory_High</li>
        <li>FCP_Nuka_Cola_Ice_Cold_High</li>
        <li>FCP_Nuka_Cola_Twist_High</li>
        <li>FCP_Nuka_Cola_Cranberry_High</li>
        <li>FCP_Nuka_Cola_Dark_High</li>
      </satisfiedHediffAny>
    </value>
  </Operation>

  <!-- Centipede blaster revenge → annihilator sentrybot (FIP RobCo) -->

  <Operation Class="PatchOperationReplace" MayRequire="VanillaExpanded.VanillaAspirationsExpanded,FIP.RobCo">
    <xpath>Defs/VAspirE.AspirationDef[defName="VAspirE_GetUltimateRevengeOnCentipede"]/label</xpath>
    <value>
      <label>get ultimate revenge on an annihilator sentrybot</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace" MayRequire="VanillaExpanded.VanillaAspirationsExpanded,FIP.RobCo">
    <xpath>Defs/VAspirE.AspirationDef[defName="VAspirE_GetUltimateRevengeOnCentipede"]/description</xpath>
    <value>
      <description>{0} wants to shred an annihilator sentrybot to show him who's boss now.</description>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace" MayRequire="VanillaExpanded.VanillaAspirationsExpanded,FIP.RobCo">
    <xpath>Defs/VAspirE.AspirationDef[defName="VAspirE_GetUltimateRevengeOnCentipede"]/satisfiedByIngredientInRecipe</xpath>
    <value>
      <satisfiedByIngredientInRecipe>Corpse_RobCo_SentrybotAnnihilator</satisfiedByIngredientInRecipe>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd" MayRequire="VanillaExpanded.VanillaAspirationsExpanded,FIP.RobCo">
    <xpath>Defs/VAspirE.AspirationDef[defName="VAspirE_GetUltimateRevengeOnCentipede"]</xpath>
    <value>
      <satisfiedWhenText>{0} butchers an annihilator sentrybot.</satisfiedWhenText>
    </value>
  </Operation>

  <!-- Consul (VFE Empire) → attorney general (FIP Whitespring) -->

  <Operation Class="PatchOperationReplace" MayRequire="VanillaExpanded.VanillaAspirationsExpanded,OskarPotocki.VFE.Empire,FIP.Whitespring">
    <xpath>Defs/VAspirE.AspirationDef[defName="VAspirE_BecomeAConsul"]/label</xpath>
    <value>
      <label>become an attorney general</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace" MayRequire="VanillaExpanded.VanillaAspirationsExpanded,OskarPotocki.VFE.Empire,FIP.Whitespring">
    <xpath>Defs/VAspirE.AspirationDef[defName="VAspirE_BecomeAConsul"]/description</xpath>
    <value>
      <description>{0} wants to gain the rank of attorney general in the Enclave hierarchy.</description>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace" MayRequire="VanillaExpanded.VanillaAspirationsExpanded,OskarPotocki.VFE.Empire,FIP.Whitespring">
    <xpath>Defs/VAspirE.AspirationDef[defName="VAspirE_BecomeAConsul"]/satisfiedWhenText</xpath>
    <value>
      <satisfiedWhenText>{0} reaches the rank of attorney general.</satisfiedWhenText>
    </value>
  </Operation>

  <!-- Join the deserters (VFE Deserters) → join the brotherhood expedition -->

  <Operation Class="PatchOperationReplace" MayRequire="VanillaExpanded.VanillaAspirationsExpanded,OskarPotocki.VFE.Deserters">
    <xpath>Defs/VAspirE.AspirationDef[defName="VAspirE_JoinTheDeserters"]/label</xpath>
    <value>
      <label>join the brotherhood expedition</label>
    </value>
  </Operation>

  <!-- Use a declassifier (VFE Deserters) → brotherhood declassifier on a Whitespring VIP -->

  <Operation Class="PatchOperationReplace" MayRequire="VanillaExpanded.VanillaAspirationsExpanded,OskarPotocki.VFE.Deserters,FIP.Whitespring">
    <xpath>Defs/VAspirE.AspirationDef[defName="VAspirE_UseADeclassifier"]/description</xpath>
    <value>
      <description>{0} wants to see what it’s like to use a brotherhood declassifier on a Whitespring VIP.</description>
    </value>
  </Operation>

  <!-- Become a sanguophage → become a wendigo (FIP WestTek) -->

  <Operation Class="PatchOperationReplace" MayRequire="VanillaExpanded.VanillaAspirationsExpanded,FIP.WestTek">
    <xpath>Defs/VAspirE.AspirationDef[defName="VAspirE_BecomeSanguophage"]/label</xpath>
    <value>
      <label>become a wendigo</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace" MayRequire="VanillaExpanded.VanillaAspirationsExpanded,FIP.WestTek">
    <xpath>Defs/VAspirE.AspirationDef[defName="VAspirE_BecomeSanguophage"]/description</xpath>
    <value>
      <description>{0} wants to live forever as a wendigo.</description>
    </value>
  </Operation>

</Patch>
