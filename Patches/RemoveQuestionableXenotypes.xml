<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Prevent WestTek Numen, Overgrown, Spore Carrier, S'Lanter, Skinwalker, and S'Nuffy
       from generating as factionless pawns or as members of unrelated factions.
       Dedicated HHTools S'Lanter / Numen / Critter factions are left alone. -->

  <!--__________ Numen __________-->
  <Operation Class="PatchOperationConditional" MayRequire="FIP.WestTek">
    <xpath>Defs/XenotypeDef[defName="WestTek_Xenotype_Numen"]/factionlessGenerationWeight</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/XenotypeDef[defName="WestTek_Xenotype_Numen"]/factionlessGenerationWeight</xpath>
      <value><factionlessGenerationWeight>0</factionlessGenerationWeight></value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/XenotypeDef[defName="WestTek_Xenotype_Numen"]</xpath>
      <value><factionlessGenerationWeight>0</factionlessGenerationWeight></value>
    </nomatch>
  </Operation>

  <!--__________ Overgrown __________-->
  <Operation Class="PatchOperationConditional" MayRequire="FIP.WestTek">
    <xpath>Defs/XenotypeDef[defName="WestTek_Xenotype_Overgrown"]/factionlessGenerationWeight</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/XenotypeDef[defName="WestTek_Xenotype_Overgrown"]/factionlessGenerationWeight</xpath>
      <value><factionlessGenerationWeight>0</factionlessGenerationWeight></value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/XenotypeDef[defName="WestTek_Xenotype_Overgrown"]</xpath>
      <value><factionlessGenerationWeight>0</factionlessGenerationWeight></value>
    </nomatch>
  </Operation>

  <!--__________ Spore Carrier __________-->
  <Operation Class="PatchOperationConditional" MayRequire="FIP.WestTek">
    <xpath>Defs/XenotypeDef[defName="WestTek_Xenotype_SporeCarrier"]/factionlessGenerationWeight</xpath>
