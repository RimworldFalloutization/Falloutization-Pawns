  <Operation Class="PatchOperationConditional" MayRequire="FIP.WestTek">
    <xpath>Defs/FactionDef[not(defName="HHTools_Mutant_Slanter" or defName="HHTools_Mutant_Numen" or defName="HHTools_Mutant_Critter")]/xenotypeSet/xenotypeChances/WestTek_Xenotype_SLanter | Defs/PawnKindDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_SLanter | Defs/MemeDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_SLanter</xpath>
    <match Class="PatchOperationRemove">
      <xpath>Defs/FactionDef[not(defName="HHTools_Mutant_Slanter" or defName="HHTools_Mutant_Numen" or defName="HHTools_Mutant_Critter")]/xenotypeSet/xenotypeChances/WestTek_Xenotype_SLanter | Defs/PawnKindDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_SLanter | Defs/MemeDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_SLanter</xpath>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional" MayRequire="FIP.WestTek">
    <xpath>Defs/FactionDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_Skinwalker | Defs/PawnKindDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_Skinwalker | Defs/MemeDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_Skinwalker</xpath>
    <match Class="PatchOperationRemove">
      <xpath>Defs/FactionDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_Skinwalker | Defs/PawnKindDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_Skinwalker | Defs/MemeDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_Skinwalker</xpath>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional" MayRequire="FIP.WestTek">
    <xpath>Defs/FactionDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_SNuffy | Defs/PawnKindDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_SNuffy | Defs/MemeDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_SNuffy</xpath>
    <match Class="PatchOperationRemove">
      <xpath>Defs/FactionDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_SNuffy | Defs/PawnKindDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_SNuffy | Defs/MemeDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_SNuffy</xpath>
    </match>
  </Operation>

</Patch>
