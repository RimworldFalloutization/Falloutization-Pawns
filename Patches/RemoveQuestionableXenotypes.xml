      <value><factionlessGenerationWeight>0</factionlessGenerationWeight></value>
    </nomatch>
  </Operation>

  <!--__________ Skinwalker __________-->
  <Operation Class="PatchOperationConditional" MayRequire="FIP.WestTek">
    <xpath>Defs/XenotypeDef[defName="WestTek_Xenotype_Skinwalker"]/factionlessGenerationWeight</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/XenotypeDef[defName="WestTek_Xenotype_Skinwalker"]/factionlessGenerationWeight</xpath>
      <value><factionlessGenerationWeight>0</factionlessGenerationWeight></value>
    </match>
    <nomatch Class="PatchOperationAdd">
