    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/XenotypeDef[defName="WestTek_Xenotype_SNuffy"]</xpath>
      <value><factionlessGenerationWeight>0</factionlessGenerationWeight></value>
    </nomatch>
  </Operation>

  <!-- Strip from unrelated faction/pawnkind/meme xenotype sets; keep HHTools dedicated factions -->
  <Operation Class="PatchOperationConditional" MayRequire="FIP.WestTek">
    <xpath>Defs/FactionDef[not(defName="HHTools_Mutant_Slanter" or defName="HHTools_Mutant_Numen" or defName="HHTools_Mutant_Critter")]/xenotypeSet/xenotypeChances/WestTek_Xenotype_Numen | Defs/PawnKindDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_Numen | Defs/MemeDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_Numen</xpath>
    <match Class="PatchOperationRemove">
      <xpath>Defs/FactionDef[not(defName="HHTools_Mutant_Slanter" or defName="HHTools_Mutant_Numen" or defName="HHTools_Mutant_Critter")]/xenotypeSet/xenotypeChances/WestTek_Xenotype_Numen | Defs/PawnKindDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_Numen | Defs/MemeDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_Numen</xpath>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional" MayRequire="FIP.WestTek">
    <xpath>Defs/FactionDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_Overgrown | Defs/PawnKindDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_Overgrown | Defs/MemeDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_Overgrown</xpath>
    <match Class="PatchOperationRemove">
      <xpath>Defs/FactionDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_Overgrown | Defs/PawnKindDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_Overgrown | Defs/MemeDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_Overgrown</xpath>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional" MayRequire="FIP.WestTek">
    <xpath>Defs/FactionDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_SporeCarrier | Defs/PawnKindDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_SporeCarrier | Defs/MemeDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_SporeCarrier</xpath>
    <match Class="PatchOperationRemove">
      <xpath>Defs/FactionDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_SporeCarrier | Defs/PawnKindDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_SporeCarrier | Defs/MemeDef/xenotypeSet/xenotypeChances/WestTek_Xenotype_SporeCarrier</xpath>
    </match>
